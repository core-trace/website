AMBIENTE_PROCESSO=producao

# Configurações de conexão com o banco de dados
DB_HOST=localhost
DB_DATABASE='coretrace'
DB_USER='root'
DB_PASSWORD=''
DB_PORT='3306'

# Configurações do servidor de aplicação
APP_PORT=3333
APP_HOST=localhost

# importante: caso sua senha contenha caracteres especiais, insira-a entre 'aspas'

# Endereço usado no link de ativação enviado por email
APP_URL=http://localhost:3333

# Preencha com a sua chave de API do Resend
RESEND_API_KEY=re_123456789

# Bucket do S3 onde o pipeline Python (scripts-captura) deixa os resumos diarios
# (client/resumos/maquina=<MAC>/data=<DIA>/resumo.json), usados pela dashboard Geral.
# As credenciais da AWS vem da cadeia padrao do SDK (ex.: ~/.aws/credentials).
BUCKET_DADOS_GOLD=

# Bucket e prefixo usados pela dashboard de Alertas para ler os lotes que o pipeline
# Python deixa em client/lotes/maquina=<MAC>/data=<DIA>/lote=<hash>/capturas.json.
# S3_PREFIX pode vir com ou sem barra no final - o servico normaliza.
# As credenciais da AWS vem da cadeia padrao do SDK (ex.: ~/.aws/credentials).
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=

# Integracao com o Jira usada pela dashboard de Alertas: abrir/criar chamados,
# consultar o status (done) e calcular o tempo medio de resolucao.
# JIRA_PROJECT_KEY e a chave do projeto onde os chamados sao criados (padrao SUP).
JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=seu-email@example.com
JIRA_API_TOKEN=seu-token-de-api
JIRA_PROJECT_KEY=SUP

# Data e hora de referencia do cenario de demonstracao (27/11/2026, 20h30, fuso de
# Sao Paulo). Servem para encontrar os lotes do cenário e calcular "ha quanto tempo"
# cada alerta esta ativo. Deixe em branco para usar a data e a hora de verdade com
# dados de producao. Ex.: DATA_DEMO_FIXA=2026-11-27 e HORA_DEMO_FIXA=20:30
DATA_DEMO_FIXA=
HORA_DEMO_FIXA=

# Remetente de teste: envia apenas ao email da sua conta Resend.
# Para outros destinatários, use um remetente de domínio verificado.
RESEND_FROM=onboarding@resend.dev
